<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 16;
      gap: 12;
      background-color: rgba(0, 10, 21, 0.95);
      border-radius: 12;
      border-color: #00ffff;
      border-width: 2;
      width: 400;
    }
    .title {
      font-size: 28;
      color: #00ffff;
    }
    .subtitle {
      font-size: 13;
      color: #888888;
    }
    .mode-label {
      font-size: 11;
      color: #666666;
    }
    .spacer {
      height: 12;
    }
    .btn-main {
      font-size: 18;
      color: #00ffff;
      background-color: #002233;
      padding: 10;
      border-radius: 8;
      border-width: 1;
      border-color: #00ffff;
      width: 220;
      text-align: center;
    }
    .btn {
      font-size: 15;
      color: #00ccaa;
      background-color: #001a22;
      padding: 8;
      border-radius: 6;
      border-width: 1;
      border-color: #004444;
      width: 220;
      text-align: center;
    }
  </style>
  <container class="root">
    <text class="title">NEON INVASION</text>
    <text class="subtitle" name="high-score">High Score: 0</text>
    <text class="mode-label" name="mode-display">Mode: CLASSIC</text>
    <container class="spacer"></container>
    <text class="btn-main" name="btn-play">PLAY</text>
    <text class="btn" name="btn-settings">Settings</text>
    <text class="btn" name="btn-tutorial">How to Play</text>
    <text class="btn" name="btn-stats">Statistics</text>
    <text class="btn" name="btn-achievements">Achievements</text>
    <text class="btn" name="btn-leaderboard">Leaderboard</text>
  </container>
</panel>
