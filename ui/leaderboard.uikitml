<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 16;
      gap: 8;
      background-color: rgba(0, 10, 21, 0.95);
      border-radius: 12;
      border-color: #ffaa00;
      border-width: 2;
      width: 400;
    }
    .title {
      font-size: 22;
      color: #ffaa00;
    }
    .divider {
      height: 1;
      width: 350;
      background-color: #333333;
    }
    .entry-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 340;
      padding: 4;
    }
    .rank {
      font-size: 14;
      color: #ffaa00;
      width: 30;
    }
    .rank-gold {
      font-size: 14;
      color: #ffdd00;
      width: 30;
    }
    .rank-silver {
      font-size: 14;
      color: #cccccc;
      width: 30;
    }
    .rank-bronze {
      font-size: 14;
      color: #cc8844;
      width: 30;
    }
    .entry-score {
      font-size: 14;
      color: #00ffff;
      width: 80;
    }
    .entry-info {
      font-size: 11;
      color: #888888;
      width: 180;
    }
    .empty {
      font-size: 12;
      color: #444444;
    }
    .btn {
      font-size: 15;
      color: #00ccaa;
      background-color: #001a22;
      padding: 8;
      border-radius: 6;
      border-width: 1;
      border-color: #004444;
      width: 220;
      text-align: center;
    }
    .spacer {
      height: 8;
    }
  </style>
  <container class="root">
    <text class="title">LEADERBOARD</text>
    <container class="divider"></container>
    <container class="entry-row">
      <text class="rank-gold" name="rank-0">1.</text>
      <text class="entry-score" name="score-0">---</text>
      <text class="entry-info" name="info-0"></text>
    </container>
    <container class="entry-row">
      <text class="rank-silver" name="rank-1">2.</text>
      <text class="entry-score" name="score-1">---</text>
      <text class="entry-info" name="info-1"></text>
    </container>
    <container class="entry-row">
      <text class="rank-bronze" name="rank-2">3.</text>
      <text class="entry-score" name="score-2">---</text>
      <text class="entry-info" name="info-2"></text>
    </container>
    <container class="entry-row">
      <text class="rank" name="rank-3">4.</text>
      <text class="entry-score" name="score-3">---</text>
      <text class="entry-info" name="info-3"></text>
    </container>
    <container class="entry-row">
      <text class="rank" name="rank-4">5.</text>
      <text class="entry-score" name="score-4">---</text>
      <text class="entry-info" name="info-4"></text>
    </container>
    <container class="divider"></container>
    <container class="spacer"></container>
    <text class="btn" name="btn-lb-back">Back</text>
  </container>
</panel>
