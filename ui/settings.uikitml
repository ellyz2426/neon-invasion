<panel>
  <style>
    .root {
      flex-direction: column;
      align-items: center;
      padding: 16;
      gap: 10;
      background-color: rgba(0, 10, 21, 0.95);
      border-radius: 12;
      border-color: #00ffff;
      border-width: 2;
      width: 380;
    }
    .title { font-size: 20; color: #00ffff; }
    .row { flex-direction: row; gap: 8; align-items: center; }
    .label { font-size: 14; color: #aaaaaa; width: 80; }
    .val { font-size: 14; color: #00ffff; width: 100; text-align: center; }
    .arrow {
      font-size: 16; color: #00ccaa;
      background-color: #001a22; padding: 4;
      border-radius: 4; border-width: 1; border-color: #004444;
    }
    .toggle {
      font-size: 14; color: #00ccaa;
      background-color: #001a22; padding: 6;
      border-radius: 4; border-width: 1; border-color: #004444;
      width: 160; text-align: center;
    }
    .btn {
      font-size: 14; color: #00ccaa;
      background-color: #001a22; padding: 6;
      border-radius: 6; border-width: 1; border-color: #004444;
      width: 120; text-align: center; margin-top: 8;
    }
  </style>
  <container class="root">
    <text class="title">SETTINGS</text>
    <container class="row">
      <text class="label">Color</text>
      <text class="arrow" name="btn-color-prev">&lt;</text>
      <text class="val" name="color-val">Cyan</text>
      <text class="arrow" name="btn-color-next">&gt;</text>
    </container>
    <container class="row">
      <text class="label">Mode</text>
      <text class="arrow" name="btn-mode-prev">&lt;</text>
      <text class="val" name="mode-val">CLASSIC</text>
      <text class="arrow" name="btn-mode-next">&gt;</text>
    </container>
    <container class="row">
      <text class="label">Difficulty</text>
      <text class="arrow" name="btn-diff-prev">&lt;</text>
      <text class="val" name="diff-val">MEDIUM</text>
      <text class="arrow" name="btn-diff-next">&gt;</text>
    </container>
    <text class="toggle" name="btn-sound-toggle">Sound: ON</text>
    <text class="btn" name="btn-settings-back">Back</text>
  </container>
</panel>
